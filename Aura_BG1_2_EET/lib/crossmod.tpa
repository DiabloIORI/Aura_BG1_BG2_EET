// Aura-Tales of the Deep Gardens
ACTION_IF MOD_IS_INSTALLED ~TOTDG/SETUP-TOTDG.TP2~ ~0~
THEN BEGIN
  PRINT ~添加奥拉与《深园传说》的交叉对话~
    COPY_EXISTING ~0XGIRLDG.CRE~ ~OVERRIDE/C0DGGIRL.CRE~
		WRITE_ASCII DIALOG ~C0DGGIRL~ // dialogue
		WRITE_ASCII SCRIPT_OVERRIDE ~C0DGGIRL~  // override
		WRITE_ASCII DEATHVAR ~C0DGGIRL~ // death variable
	COPY ~%MOD_FOLDER%/dialogue/BG2EE/crossmod/totdg/itm~ ~override~
	COPY ~%MOD_FOLDER%/dialogue/BG2EE/crossmod/totdg/spl~ ~override~
	COPY_EXISTING ~C0DGCoin.ITM~ ~OVERRIDE~
	SAY NAME1 ~金币~
	SAY NAME2 ~金币~
	SAY DESC ~这枚金币是深园里那个古怪的小姑娘拿奥拉一绺头发换给她的。除了正面铸着一个小姑娘的笑脸——就是给奥拉这枚币的那个姑娘——它与别的金币毫无分别。币面的光泽映出一丝隐约的暖意。

重量：1~
	COMPILE ~%MOD_FOLDER%/dialogue/BG2EE/crossmod/totdg/d/dialog.d~
	EXTEND_TOP ~ARLDV1.BCS~ ~%MOD_FOLDER%/dialogue/BG2EE/crossmod/totdg/BAF/ARLDV1.BAF~
	EXTEND_TOP ~AR1000.BCS~ ~%MOD_FOLDER%/dialogue/BG2EE/crossmod/totdg/BAF/AR1000.BAF~
END

