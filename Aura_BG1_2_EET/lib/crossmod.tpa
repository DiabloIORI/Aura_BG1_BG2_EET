// Aura-Yvette
ACTION_IF MOD_IS_INSTALLED ~Yvette/Setup-Yvette.tp2~ ~0~
THEN BEGIN
  PRINT ~添加奥拉与伊薇特的交叉对话~
	COMPILE ~%MOD_FOLDER%/dialogue/BG2EE/crossmod/yvette/d/interjections.d~
	EXTEND_BOTTOM ~c0aura2.bcs~ ~%MOD_FOLDER%/dialogue/BG2EE/crossmod/yvette/baf/scripts.baf~

COPY ~%MOD_FOLDER%/dialogue/BG2EE/crossmod/yvette/itm/C0YXY3.ITM~ ~OVERRIDE~
  LPF ADD_ITEM_EQEFFECT
    INT_VAR
      opcode = 319
	  target = 1
	  timing = 2
	  parameter2 = 11
	  power = 1
	  special = RESOLVE_STR_REF (~伊薇特~)
	STR_VAR
	  resource = YxYve
END
SAY NAME1 ~短弓~
SAY NAME2 ~宁静白日梦~
SAY DESC ~这把弓是太阳女神淑妮的护心者伊薇特的另一件爱用武器。上等木料，弓弦紧得恰到好处。一位认真的兰坦奇械师又为它精巧的工艺添了改良，使它射得更快、更准。

属性数据：

战斗能力：
– 每回合射击 2.5 次
– 未装备箭矢时，弓射出的弹丸在判定能否伤害敌人时视作 +3；弹丸获得 +2 命中（已含下列加值），并造成 1d4+2 穿刺伤害

装备能力：
– 免疫恐惧

零级命中值：+2
伤害类型：穿刺
重量：2 磅
速度值：2
擅长类型：短弓
类型：双手~

END