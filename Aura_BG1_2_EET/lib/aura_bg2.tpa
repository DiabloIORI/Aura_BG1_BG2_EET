// map icon index in mapicons.bam
ACTION_IF GAME_IS ~eet~ BEGIN
  ACTION_DEFINE_ASSOCIATIVE_ARRAY remapped_icons BEGIN 10 => 179 END
END ELSE ACTION_IF GAME_IS ~bg2ee~ BEGIN
  INCLUDE ~%MOD_FOLDER%/Worldmap/add_map_icons_ee.tpa~
  LAF ADD_MAP_ICONS_EE STR_VAR path_to_icons = EVAL ~%MOD_FOLDER%/Worldmap/icon/icon.bam~ patch_to_pvrz = EVAL ~%MOD_FOLDER%/Worldmap/icon~ RET new_icon_index END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY remapped_icons BEGIN 10 => ~%new_icon_index%~ END
  STRING_SET 23084 ~Hours~ //Traveling Hours -> Hours
  STRING_SET 5684 ~Unreachable~ //Destination Unreachable -> Unreachable
END ELSE BEGIN //bg2, bgt
  INCLUDE ~%MOD_FOLDER%/Worldmap/add_map_icons.tpa~
  LAF ADD_MAP_ICONS STR_VAR path_to_icons = EVAL ~%MOD_FOLDER%/Worldmap/icon/icon.bam~ RET new_icon_index END
  ACTION_DEFINE_ASSOCIATIVE_ARRAY remapped_icons BEGIN 10 => ~%new_icon_index%~ END
END

COPY_EXISTING ~AR0300.are~ ~override/C0AUF3.ARE~
WRITE_ASCII AREA_SCRIPT ~~ #8
 FOR( i = SHORT_AT 0x82 ; i ; --i )BEGIN
 LPF fj_are_structure
 INT_VAR fj_delete_mode = i - 1
 STR_VAR fj_structure_type = actor
 END
 END

