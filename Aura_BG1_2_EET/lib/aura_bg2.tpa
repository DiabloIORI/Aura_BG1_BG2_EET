//Fate Spirit
ACTION_IF GAME_IS ~eet~ BEGIN
ACTION_IF MOD_IS_INSTALLED ~Aura_BG1/Aura_BG1.tp2~ ~0~ BEGIN
  OUTER_SET type_var = 3 //this will change already applied type of transition = 1 to 3
END ELSE BEGIN
  OUTER_SET type_var = 2 //BG1 version of NPC is not installed, so just add BG2 only transition
END
  INCLUDE ~EET/other/EET_functions.tph~
  LAF ~EET_NPC_TRANSITION~
    INT_VAR
      type = type_var
    STR_VAR
      dv = "C0Aura"
      override_BG1 = "C0AURA" //won't be used if type_var = 2
      override_SoD = "C02AURA" //won't be used if type_var = 2
      override_SoA = "C0AURA2"
      override_ToB = "C0AURA25"
      dialog_ToB = "C0Aura25"
      //traFile = EVAL "%MOD_FOLDER%/translations/%LANGUAGE%/aura.tra"
      string = "Bring me Aura, the gnome artificer."
      stringPosDV = "Cernd"
  END
END ELSE BEGIN
  COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/dialogue/BG2EE/FATESP.d~
END

