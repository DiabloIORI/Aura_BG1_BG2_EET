COPY ~%MOD_FOLDER%/animations/BG2~ ~override~

ACTION_IF NOT FILE_EXISTS ~MGIRA1.BAM~ THEN BEGIN
COPY ~%MOD_FOLDER%/animations/BG2/keg~ ~override~
END

ACTION_DEFINE_ASSOCIATIVE_ARRAY Aura_BG1_2_EET_anims_Exxx BEGIN
    ~snow_hag~ => ~C0_SNOW_HAG~
    ~mithril_golem~ => ~C0_MITHRIL_GOLEM~
    ~adamantite_golem~ => ~C0_ADAMANTITE_GOLEM~
    ~golem_iron_small~ => ~C0_GOLEM_IRON_SMALL~
    ~shield_guard~ => ~C0_SHIELD_GUARD~
    ~mutant~ => ~C0_MUTANT~
  END
  ACTION_PHP_EACH Aura_BG1_2_EET_anims_Exxx AS folder => symbol BEGIN
    ACTION_BASH_FOR ~%MOD_FOLDER%/animations/BG2/%folder%~ ~.+\.bam~ ~%MOD_FOLDER%/animations/BG2/%folder%~ ~.+\.bmp~ BEGIN
      COPY ~%BASH_FOR_FILESPEC%~ ~override~
    END
    LAF FIND_FREE_ANIM_SLOT INT_VAR slotMin = 0xE000 RET slot END
    LAF TO_HEX_NUMBER INT_VAR value = slot minDigits = 4 RET hexNumber END
    COPY ~%MOD_FOLDER%/animations/BG2/%folder%/Exxx.ini~ ~override/%hexNumber%.ini~
    OUTER_SET EVAL ~slot_%folder%~ = slot   // save animation slot number for later
    APPEND ~ANIMATE.IDS~ ~0x%hexNumber% %symbol%~
END
//AUDIO

LAF HANDLE_AUDIO END

DEFINE_PATCH_FUNCTION ~GET_2DA_ROW~
	INT_VAR
		starting_row=0
		numcolumns=0
		match_column=0
		found_it=0
	STR_VAR
		match=~DEFA~
	RET
		numcols
		matched
BEGIN
		COUNT_2DA_ROWS numcolumns numrows
		FOR (i = starting_row; i < numrows; ++i) BEGIN
			READ_2DA_ENTRY i match_column numcolumns string_to_match
			PATCH_IF (~%string_to_match%~ STRING_EQUAL_CASE ~%match%~) BEGIN
				matched = i
				found_it = 1
				i = numrows

			END
		END
		numcols = numcolumns
		PATCH_IF (found_it = 0) BEGIN
			PATCH_FAIL ~GET_2DA_ROW: Could not find a row that contains %match% in column %match_column%.~
		END
END
	
ADD_MUSIC ~C0AUROM~ ~%MOD_FOLDER%/music/C0AUROM.mus~
COPY ~%MOD_FOLDER%/music/C0AUROMa.acm~ ~MUSIC/C0AUROM/C0AUROMa.acm~

COPY_EXISTING ~SONGLIST.2da~ ~override~
	LPF GET_2DA_ROW INT_VAR numcolumns=3 match_column=2 STR_VAR match=~C0AUROM.mus~ RET therow=matched END
