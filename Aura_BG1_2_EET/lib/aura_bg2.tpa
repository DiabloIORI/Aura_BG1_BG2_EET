COPY_EXISTING ~c0asmok1.spl~ ~override~
READ_LONG 0x64 "abil_off"
READ_SHORT 0x68 "abil_num"
SET "delta" = 0
FOR (index = 0; index < abil_num; index = index + 1) BEGIN
WRITE_SHORT (%abil_off% + (0x28 * %index%) + 0x26) ~%c0abomb3%~
END
  LPF ALTER_EFFECT
    INT_VAR
      match_opcode = 139 // display string
 parameter1 = RESOLVE_STR_REF (~震慑~)
END

