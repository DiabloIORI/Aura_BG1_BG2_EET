COPY_EXISTING ~C0MDaggS.spl~ ~override~
READ_LONG 0x64 "abil_off"
READ_SHORT 0x68 "abil_num"
SET "delta" = 0
FOR (index = 0; index < abil_num; index = index + 1) BEGIN
WRITE_SHORT (%abil_off% + (0x28 * %index%) + 0x26) ~%c0mboom%~
END
      LPF ALTER_EFFECT
      INT_VAR
        match_opcode      = 139   // Display portrait icon
        parameter1 = RESOLVE_STR_REF (~震慑~)
      END
COPY_EXISTING ~C0MDagg3.itm~ ~override~
  LPF ADD_ITEM_EQEFFECT
    INT_VAR
      opcode = 319
	  target = 1
	  timing = 2
	  parameter1 = (IDS_OF_SYMBOL (~kit~ ~C0AURA~))
	  parameter2 = 9
	  power = 1
	  special = RESOLVE_STR_REF (~奇械师~)
END
      LPF ALTER_EFFECT
      INT_VAR
        match_opcode      = 139   // Display portrait icon
        parameter1 = RESOLVE_STR_REF (~震慑~)
      END
SAY NAME1 ~飞刀~
SAY NAME2 ~爆裂飞刀 +4~
SAY DESC ~爆裂飞刀比寻常匕首略大，刀身中空、握柄可拆，内部可容纳少量爆炸油。当连接于柄上的短引线点燃，飞刀必须迅速而准确地掷出，因为油一经引燃便会爆出炽烈冲击。这是危险而强力的武器，只有娴熟的奇械师才能安全使用。

属性数据：

战斗能力：
– 每回合 3 次攻击
– 造成 5d6 点火焰伤害，且目标对抗吐息豁免 -2 失败时被震慑。若目标死亡，则发生爆炸，对 5 英尺半径内所有生物施加同样效果。

零级命中值：+4
伤害：1d4+4（远程）
速度值：0
擅长类型：匕首
类型：单手
需求：
 力量 3

重量：0~

