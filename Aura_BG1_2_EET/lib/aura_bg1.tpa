LOAD_TRA ~%MOD_FOLDER%/tra/%LANGUAGE%/setup.tra~

APPEND ~STATE.IDS~ // adds custom IsValidForPartyDialogue state
  ~0x80101FEF CD_STATE_NOTVALID~
  UNLESS ~CD_STATE_NOTVALID~
  
// BAELOTH BANTER

ACTION_IF FILE_EXISTS_IN_GAME ~neera.dlg~ THEN BEGIN
 PRINT ~BG:EE detected - Baeloth interdia.2da append - set Baeloth's banter file (BBAELOTH)~
    APPEND ~interdia.2da~ ~BAELOTH BBAELOTH~
    UNLESS ~BAELOTH~
   ACTION_IF NOT (FILE_EXISTS_IN_GAME ~BBAELOTH.dlg~) THEN BEGIN
   COMPILE EVALUATE_BUFFER ~%MOD_FOLDER%/dialogue/BBAELOTHFix.d~
  END
END

//AUDIO

LAF HANDLE_AUDIO END

// CREATURES

// SINGLE-CLASS ARTIFICER
ACTION_IF (auraclass = 1) THEN BEGIN
COPY ~%MOD_FOLDER%/creatures/C0Aura.cre~ ~override/C0Aura.cre~
  SAY NAME1 ~奥拉~
  SAY NAME2 ~奥拉~
  WRITE_ASCII 0x248 ~C0Aura~ #8  //override script
  WRITE_ASCII 0x280 ~C0Aura~ #32  //DV
  WRITE_ASCII 0x2cc ~C0Aura~ #8   //pre-joining dialogue file
  WRITE_ASCII 0X34 ~C0AuraM~ #8   //small portrait
  WRITE_ASCII 0x3c ~C0AuraL~ #8   //medium portrait
  SAY BIO ~问起过去，奥拉会给你讲一段漫长曲折的生平，自童年一直讲到她在遥远科祖库拉的日子。她出身于“开化”岛国兰坦的名门格利默夏恩家族，那里以发明与制造之术闻名。奥拉年幼便在制造与创造上显露天赋，又对家外的世界满怀好奇，于是远行异域以求长进文化见识，并把知识传授给较为落后的社会。 
  
兰坦人少有远离费伦西部者，奥拉却游历异常广远，曾到过费伦最遥远的地方，甚至超乎其外。其中，她自称在遥远的科祖库拉暂居过——那是东方卡拉图的国度。奥拉的创造才能在所居村庄让她赢得当地人的接纳，她在那里安了新家三年，此后一连串事件使她动身前往剑湾。~
  SAY MORALE ~快跑！快跑！~ [C0AU001]
  SAY HAPPY ~我很高兴决定跟你一起旅行。~ [C0AU002]
  SAY UNHAPPY_ANNOYED ~那只是个无心的失误……对吧？~ [C0AU003]
  SAY UNHAPPY_SERIOUS ~真不敢信有人能这么差劲。~ [C0AU004]
  SAY UNHAPPY_BREAKING_POINT ~够……够了。我受不了了。我走了。~ [C0AU005]
  SAY LEADER ~呃……好。我尽力！~ [C0AU006]
  SAY TIRED ~能不能歇一会儿？我想要茶和饼干……~ [C0AU007]
  SAY BORED ~别担心，你干你的，呃，什么也不干，我就做我的下一个发明。~ [C0AU008]
  SAY BATTLE_CRY1 ~我本不想打的！~ [C0AU009]
  SAY BATTLE_CRY2 ~准备，瞄准，放！~ [C0AU010]
  SAY BATTLE_CRY3 ~我从不会失手！~ [C0AU011]
  SAY BATTLE_CRY4 ~你逃不出我的手心！~ [C0AU012]
  SAY BATTLE_CRY5 ~好，我来！~ [C0AU013]
  SAY DAMAGE ~哎哟！~ [C0AU014]
  SAY DYING ~啊……~ [C0AU015]
  SAY HURT ~好疼……~ [C0AU016]
  SAY AREA_FOREST ~哦，我爱森林。它让我想起家。~ [C0AU017]
  SAY AREA_CITY ~这些城跟我故乡差别太大了。~ [C0AU018]
  SAY AREA_DUNGEON ~小心，穆菲，附近也许有鬼。~ [C0AU019]
  SAY AREA_DAY ~阳光照在我头发上真好。看它闪闪的吗？~ [C0AU020]
  SAY AREA_NIGHT ~我不怕黑。真的，我不怕！~ [C0AU021]
  SAY SELECT_COMMON1 ~嗯？~ [C0AU022]
  SAY SELECT_COMMON2 ~嗯——？~ [C0AU023]
  SAY SELECT_COMMON3 ~我听着。~ [C0AU024]
  SAY SELECT_ACTION1 ~好。~ [C0AU028]
  SAY SELECT_ACTION2 ~我来了。~ [C0AU029]
  SAY SELECT_ACTION3 ~这活正适合我。~ [C0AU030]
  SAY CRITICAL_HIT ~哈哈！正中目标！~ [C0AU036]
  SAY CRITICAL_MISS ~哎呀！那一下我弄砸了。~ [C0AU037]
  SAY TARGET_IMMUNE ~哦，有意思。它直接弹开了。~ [C0AU038]
  SAY INVENTORY_FULL ~嘿，我个子不够大，搬不动这些。~ [C0AU039]
  SAY SPELL_DISRUPTED ~哦，螺母和螺栓！我费了好大劲做的！~ [C0AU040]
  SAY SET_A_TRAP ~这才叫动脑子。~ [C0AU041]
  SAY HIDDEN_IN_SHADOWS ~我会安静得像只老鼠。~ [C0AU042]
  SAY PICKED_POCKET ~嗯？这是什么？~ [C0AU043]
  WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~C0AURA~))

ACTION_IF GAME_INCLUDES ~sod~
THEN BEGIN
COPY ~%MOD_FOLDER%/creatures/SoD/c02aura.cre~ ~override~
  SAY NAME1 ~奥拉~
  SAY NAME2 ~奥拉~
  WRITE_ASCII 0x248 ~C02Aura~ #8  //override script
  WRITE_ASCII 0x280 ~C0Aura~ #32  //DV
  WRITE_ASCII 0x2cc ~C02Aura~ #8   //pre-joining dialogue file
  WRITE_ASCII 0X34 ~C0AuraM~ #8   //small portrait
  WRITE_ASCII 0x3c ~C0AuraL~ #8   //medium portrait
  SAY BIO ~问起过去，奥拉会给你讲一段漫长曲折的生平，自童年一直讲到她在遥远科祖库拉的日子。她出身于“开化”岛国兰坦的名门格利默夏恩家族，那里以发明与制造之术闻名。奥拉年幼便在制造与创造上显露天赋，又对家外的世界满怀好奇，于是远行异域以求长进文化见识，并把知识传授给较为落后的社会。 
  
兰坦人少有远离费伦西部者，奥拉却游历异常广远，曾到过费伦最遥远的地方，甚至超乎其外。其中，她自称在遥远的科祖库拉暂居过——那是东方卡拉图的国度。奥拉的创造才能在所居村庄让她赢得当地人的接纳，她在那里安了新家三年，直到一桩灾难性的委托令她蒙羞，随后她离开科祖库拉。在剑湾，她终与昔日的对手兼旧友、失势的武士斋藤忠桥相遇，满怀悔恨地结果了他的性命。

北行途中，奥拉屡屡被迫躲避或自保，以应对那些无疑会逼她以技术才智为其大业效力的十字军。她虽不愿动武，却已与焰拳结盟，既为自保，也因那是她自己的选择。~
  SAY MORALE ~快跑！快跑！~ [C0AU001]
  SAY HAPPY ~我很高兴决定跟你一起旅行。~ [C0AU002]
  SAY UNHAPPY_ANNOYED ~那只是个无心的失误……对吧？~ [C0AU003]
  SAY UNHAPPY_SERIOUS ~真不敢信有人能这么差劲。~ [C0AU004]
  SAY UNHAPPY_BREAKING_POINT ~够……够了。我受不了了。我走了。~ [C0AU005]
  SAY LEADER ~呃……好。我尽力！~ [C0AU006]
  SAY TIRED ~能不能歇一会儿？我想要茶和饼干……~ [C0AU007]
  SAY BORED ~别担心，你干你的，呃，什么也不干，我就做我的下一个发明。~ [C0AU008]
  SAY BATTLE_CRY1 ~我本不想打的！~ [C0AU009]
  SAY BATTLE_CRY2 ~准备，瞄准，放！~ [C0AU010]
  SAY BATTLE_CRY3 ~我从不会失手！~ [C0AU011]
  SAY BATTLE_CRY4 ~你逃不出我的手心！~ [C0AU012]
  SAY BATTLE_CRY5 ~好，我来！~ [C0AU013]
  SAY DAMAGE ~哎哟！~ [C0AU014]
  SAY DYING ~啊……~ [C0AU015]
  SAY HURT ~好疼……~ [C0AU016]
  SAY AREA_FOREST ~哦，我爱森林。它让我想起家。~ [C0AU017]
  SAY AREA_CITY ~这些城跟我故乡差别太大了。~ [C0AU018]
  SAY AREA_DUNGEON ~小心，穆菲，附近也许有鬼。~ [C0AU019]
  SAY AREA_DAY ~阳光照在我头发上真好。看它闪闪的吗？~ [C0AU020]
  SAY AREA_NIGHT ~我不怕黑。真的，我不怕！~ [C0AU021]
  SAY SELECT_COMMON1 ~嗯？~ [C0AU022]
  SAY SELECT_COMMON2 ~嗯——？~ [C0AU023]
  SAY SELECT_COMMON3 ~我听着。~ [C0AU024]
  SAY SELECT_COMMON4 ~要帮忙吗？~ [C0AU025]
  SAY SELECT_COMMON5 ~要个小装置吗？~ [C0AU026]
  SAY SELECT_COMMON6 ~你需要什么都行！~ [C0AU027]
  SAY SELECT_ACTION1 ~好。~ [C0AU028]
  SAY SELECT_ACTION2 ~我来了。~ [C0AU029]
  SAY SELECT_ACTION3 ~这活正适合我。~ [C0AU030]
  SAY CRITICAL_HIT ~哈哈！正中目标！~ [C0AU036]
  SAY CRITICAL_MISS ~哎呀！那一下我弄砸了。~ [C0AU037]
  SAY TARGET_IMMUNE ~哦，有意思。它直接弹开了。~ [C0AU038]
  SAY INVENTORY_FULL ~嘿，我个子不够大，搬不动这些。~ [C0AU039]
  SAY SPELL_DISRUPTED ~哦，螺母和螺栓！我费了好大劲做的！~ [C0AU040]
  SAY SET_A_TRAP ~这才叫动脑子。~ [C0AU041]
  SAY HIDDEN_IN_SHADOWS ~我会安静得像只老鼠。~ [C0AU042]
  SAY PICKED_POCKET ~嗯？这是什么？~ [C0AU043]
  WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~C0AURA~))
END
END

