OUTER_SET multikitname = RESOLVE_STR_REF (~奇械师~)
COPY_EXISTING ~c0aunam.eff~ ~override~
WRITE_LONG 0x1c %multikitname%

COPY_EXISTING ~c0aubear.spl~ ~override~
SAY NAME1 ~我讨厌熊！~
SAY NAME2 ~我讨厌熊！~

COPY_EXISTING ~c0auin1.2da~ ~override~
COPY_EXISTING ~c0auin1.spl~ ~override~
SAY NAME1 ~布置炼金陷阱~
SAY NAME2 ~布置炼金陷阱~
SAY UNIDENTIFIED_DESC ~布置炼金陷阱
在目标地点布下陷阱，需附近无敌对生物。陷阱造成奇械师所选元素（火、冷、酸、电）伤害 2d4（每 3 级额外 +1d4），范围 10 尺，并附加持续 2 轮 + 每 3 级 1 轮的效果。效果依所选元素而定。炼金陷阱只会被敌人触发，但会影响范围内的所有生物。

  炼金师之火：陷阱伤害提升为 d6，并使目标「着火」，每轮额外受 1d4 火焰伤害。
  急速冷冻：目标陷入「缓慢」，THAC0 与防御等级 -4。
  酸性化合物：目标染上「腐蚀」，物理抗性与伤害 -25%。
  电荷：目标陷入「电击」，每轮有 10% 几率被麻痹 1 轮。~

ADD_PROJECTILE ~%MOD_FOLDER%/artificer/projectiles/c0atrap1.PRO~
ADD_PROJECTILE ~%MOD_FOLDER%/artificer/projectiles/c0atrap2.PRO~
ADD_PROJECTILE ~%MOD_FOLDER%/artificer/projectiles/c0atrap3.PRO~
ADD_PROJECTILE ~%MOD_FOLDER%/artificer/projectiles/c0atrap4.PRO~
ADD_PROJECTILE ~%MOD_FOLDER%/artificer/projectiles/c0atrap5.PRO~
ADD_PROJECTILE ~%MOD_FOLDER%/artificer/projectiles/c0atrap6.PRO~
ADD_PROJECTILE ~%MOD_FOLDER%/artificer/projectiles/c0atrap7.PRO~
ADD_PROJECTILE ~%MOD_FOLDER%/artificer/projectiles/c0atrap8.PRO~

COPY_EXISTING ~c0atrap1.spl~ ~override~
READ_LONG 0x64 "abil_off"
READ_SHORT 0x68 "abil_num"
SET "delta" = 0
FOR (index = 0; index < abil_num; index = index + 1) BEGIN
WRITE_SHORT (%abil_off% + (0x28 * %index%) + 0x26) ~%c0atrap1%~
END
COPY_EXISTING ~c0atrap5.spl~ ~override~
READ_LONG 0x64 "abil_off"
READ_SHORT 0x68 "abil_num"
SET "delta" = 0
FOR (index = 0; index < abil_num; index = index + 1) BEGIN
WRITE_SHORT (%abil_off% + (0x28 * %index%) + 0x26) ~%c0atrap5%~
END
		LPF	ADD_SPELL_EFFECT
			INT_VAR
				insert_point = 0
				opcode = 324
				target = 2
				parameter2 = FIRE
				duration = 1
