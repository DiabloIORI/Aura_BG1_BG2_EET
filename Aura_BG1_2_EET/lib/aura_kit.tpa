COPY_EXISTING ~c0apoth5.spl~ ~override~
  LPF ALTER_EFFECT
    INT_VAR
      match_opcode = 177
	  match_parameter2 = 9
	  parameter1 = IDS_OF_SYMBOL (~KIT~ ~C0AURA~)
  END
  LPF ALTER_EFFECT
    INT_VAR
      check_globals = 1
      check_headers = 1
      match_opcode = 139 // display string
	  parameter1 = RESOLVE_STR_REF (~永久属性提升~)
  END
