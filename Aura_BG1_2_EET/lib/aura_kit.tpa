  // Borrowed from Rogue Rebalancing
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_MaxLevel = 20 STR_VAR f_Entry = AP_C0AUKT4 END // SPELL SLOT MODIFIER
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 3 f_MaxLevel = 20 STR_VAR f_Entry = AP_C0AUKT4 END // SPELL SLOT MODIFIER
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 5 f_MaxLevel = 20 STR_VAR f_Entry = AP_C0AUKT5 END // SPELL LEVEL MODIFIER
  PRETTY_PRINT_2DA
BUT_ONLY


// LORE CHECK
APPEND ~splprot.2da~ ~C0AULORE%TAB%25%TAB%-1%TAB%4~
COPY_EXISTING ~splprot.2da~ ~override~
	COUNT_2DA_COLS cols // amount of columns
	READ_2DA_ENTRIES_NOW rows cols // read all file into memory  
	FOR (row = 1; row < rows; ++row) BEGIN // iterate over rows
	  READ_2DA_ENTRY_FORMER rows row 0 ~stat~ // read column value
	  PATCH_IF ~%stat%~ STRING_EQUAL_CASE ~C0AULORE~ BEGIN
	    SET C0AULORE = %row%
	  END
	END
	
COPY_EXISTING ~c0aukt5a.spl~ ~override~
LPF ALTER_EFFECT INT_VAR match_opcode = 326 parameter2 = C0AULORE END

COPY_EXISTING ~c0auhl1.spl~ ~override~
SAY NAME1 ~元素精通~
SAY UNIDENTIFIED_DESC ~奇械师已精通在工艺中运用元素能量，永久获得对酸、冷、电、火与魔法伤害的 30% 抗性，并提升这些伤害的输出。~

COPY_EXISTING ~c0auhl2.spl~ ~override~
SAY NAME1 ~本体惰性~
SAY UNIDENTIFIED_DESC ~借助奇术机构，奇械师把魔法的效力延长到超出其原本的失效时限，永久使所有奥术法术的持续时间增加 50%。~

COPY_EXISTING ~c0auhl3.spl~ ~override~
SAY NAME1 ~奇术矩阵~
SAY UNIDENTIFIED_DESC ~此能力让奇械师把法术储存进一个由法术生成的魔法能力（通过「特殊能力」按钮取用）。这件物品——矩阵——可储存三个法术，等级不超过奇械师可施的最高法术等级，能同时以最高法术威力释放，并获得双倍持续时间修正。奇械师同时只能持有一个奇术矩阵，且矩阵不能交给其他角色。奇术矩阵一旦使用，图标就会从「特殊能力」按钮上消失。~

COPY_EXISTING ~c0auhl3d.spl~ ~override~
SAY NAME1 ~奇术矩阵~
SAY UNIDENTIFIED_DESC ~此能力让奇械师把法术储存进一个由法术生成的魔法能力（通过「特殊能力」按钮取用）。这件物品——矩阵——可储存三个法术，等级不超过奇械师可施的最高法术等级，能同时以最高法术威力释放，并获得双倍持续时间修正。奇械师同时只能持有一个奇术矩阵，且矩阵不能交给其他角色。奇术矩阵一旦使用，图标就会从「特殊能力」按钮上消失。~

COPY_EXISTING ~c0auhl3p.spl~ ~override~
SAY NAME1 ~奇术矩阵~
SAY UNIDENTIFIED_DESC ~此能力让奇械师把法术储存进一个由法术生成的魔法能力（通过「特殊能力」按钮取用）。这件物品——矩阵——可储存三个法术，等级不超过奇械师可施的最高法术等级，能同时以最高法术威力释放，并获得双倍持续时间修正。奇械师同时只能持有一个奇术矩阵，且矩阵不能交给其他角色。奇术矩阵一旦使用，图标就会从「特殊能力」按钮上消失。~

OUTER_SET thaumaturgical_matrix_tip = RESOLVE_STR_REF (~奇术矩阵与「法术连锁触发」颇为相似：它让施法者把若干法术存入一件触发物品，可对任意目标（包括施法者本人）释放。存入矩阵的法术如同其他法术一样施放，可通过主界面的「特殊能力」按钮取用。需要特别注意的是，当你选择要存入矩阵的法术时，它们会从你已记忆的法术中消失。不过矩阵会一直保存到使用为止，所以施法者可以休息并把那些法术重新记回。此法的主要用途，是让施法者在战斗中迅速对目标连发多个法术，而不必担心被打断。~)

OUTER_SET thaumaturgical_matrix_title = RESOLVE_STR_REF (~奇术矩阵~)

OUTER_SET thaumaturgical_matrix_label = RESOLVE_STR_REF (~将法术加入矩阵~)

APPEND	~BGEE.LUA~	~mageBookStrings['C0AUHL3'] = {tip = %thaumaturgical_matrix_tip%, title = 'C0AURA_SEQUENCER_TITLE', action = "C0AURA_SEQUENCER_LABEL"}~
APPEND	~L_en_US.LUA~	~uiStrings['C0AURA_SEQUENCER_TITLE'] = "法术矩阵"
uiStrings['C0AURA_SEQUENCER_LABEL'] = "将法术加入你的矩阵"~

      PRINT ~Installed Aura as an Artificer (EEex Version)~
      END
      END
	
