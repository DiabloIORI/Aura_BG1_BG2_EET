// Writes a new item type into the itemtype.2da and returns the reference value.
LAF ADD_ITEMTYPE_IN_2DA
		INT_VAR
			inventorySlotType 	= 35
		STR_VAR
			soundGrab		= EVAL ~GAM_38A~
			soundDrop		= EVAL ~GAM_38B~
		RET
			grenade 		= typeNumber
END

COPY_EXISTING ~c0abomb1.spl~ ~override~
READ_LONG 0x64 "abil_off"
READ_SHORT 0x68 "abil_num"
SET "delta" = 0
FOR (index = 0; index < abil_num; index = index + 1) BEGIN
WRITE_SHORT (%abil_off% + (0x28 * %index%) + 0x26) ~%c0abomb1%~
END
		LPF	ADD_SPELL_EFFECT
			INT_VAR
				insert_point = 0
				opcode = 324
				target = 2
				parameter2 = FIRE
				duration = 1
			STR_VAR
				resource = EVAL ~%SOURCE_RES%~
		END
  LPF ALTER_EFFECT
    INT_VAR
      match_opcode = 142
	  parameter2 = c0aicon3
END
COPY_EXISTING ~c0abomb1.itm~ ~override~
	WRITE_SHORT 0x001c	~%grenade%~
  LPF ADD_ITEM_EQEFFECT
    INT_VAR
      opcode = 319
	  target = 1
	  timing = 2
	  parameter1 = (IDS_OF_SYMBOL (~kit~ ~C0AURA~))
	  parameter2 = 9
	  power = 1
	  special = RESOLVE_STR_REF (~奇械师~)
END
SAY NAME1 ~燃烧弹~
SAY NAME2 ~绿色燃烧油~
SAY DESC ~这只玻璃罐里装着油与多种化学品的昂贵混合物。点燃后，它会以极高的温度燃烧数秒。燃烧油有时不太好用，因为使用者得花不少时间才能把它妥善掷出。冒险者常随身带着油，以备不幸遇上巨魔时派上用场。

奥拉所用的瓶装油是特制的，会释放极易燃的气体。火焰呈翡翠绿，与油本身一样。

属性：

投掷出去后释放一团烟云，每轮对云内所有生物造成伤害（对抗吐息武器豁免成功则减半）。离开效果范围的受创目标仍会在之后两轮内继续受伤。烟云持续五轮。
  1 级：2d3 火焰伤害（对抗吐息豁免）
  10 级：4d3 火焰伤害（对抗吐息豁免 -1）
  20 级：4d6 无法减免的火焰伤害（对抗吐息豁免 -2）

重量：0~
